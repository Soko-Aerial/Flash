<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Flash" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Cold-start splash (androidx core-splashscreen, works down to minSdk 24). The ground +
      bolt bridge the gap before Compose renders; postSplashScreenTheme hands off to
      Theme.Flash. On a cold start with the "Launch animation" setting on, MainActivity
      releases this splash at once and fades it into the Compose Ink splash (UI-056,
      FlashLaunchSplashOverlay); otherwise it stays until the engine is ready.
    -->
    <style name="Theme.Flash.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/flash_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/flash_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Flash</item>
    </style>
</resources>
