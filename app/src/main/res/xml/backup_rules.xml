<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower Auto Backup rules. Same policy as data_extraction_rules.xml (audit S4):
    trust state, sealed keys, identity, the wrapped DB passphrase and the SQLCipher DB never leave
    the device; received files stay out of the 25 MB quota.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
