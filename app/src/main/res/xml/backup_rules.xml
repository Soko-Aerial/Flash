<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower Auto Backup rules. Same policy as data_extraction_rules.xml (audit S4):
    trust state, sealed keys, identity, the wrapped DB passphrase and the SQLCipher DB never leave
    the device. Received files and submitted voice recordings are excluded too.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
    <exclude domain="file" path="logs" />
    <exclude domain="file" path="swarm" />
    <exclude domain="file" path="FlashReceived" />
    <exclude domain="file" path="sent" />
</full-backup-content>
