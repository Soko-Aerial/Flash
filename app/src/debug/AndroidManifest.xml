<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HIB-10 (debug builds only, never in release): a heartbeat service in its own process, to
         measure whether a second process of the same app survives the Transsion Hiber freezer
         (which freezes by UID, ERROR-074). exported so `adb shell am start-foreground-service` can
         start it; it does nothing but log. See docs/network/TRANSSION-BACKGROUND-DELIVERY-RESEARCH.md. -->
    <application>
        <service
            android:name="com.transfer.flash.debug.DaemonProbeService"
            android:process=":lan_daemon"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
