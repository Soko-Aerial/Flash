build/
*.hprof
*.hprof.p*
.gradle/
.idea/
local.properties
.DS_Store
captures/
.externalNativeBuild/
.cxx/
*.log
session-export*/
session-export-*/
logs/cli-diagnostics*.jsonl
testfile.bin
logo-claude/
.kotlin/
.codegraph/
.omo/
.gradle-user-home/
.gradle-user-home-verify/
.kilo/

# Release builds (tools/build-release.ps1): outputs and the signing key config never go in git.
dist/
keystore.properties
*.jks
*.keystore
# SEC-D22-02: private keys and certificates with keys, wherever they land.
*.pem
*.key
*.p12
*.pfx
*.pk8
# PC0 and later device measurement dumps (tools/pc0); summaries go to logs/experiments.md
measurements/

# Server runtime state and local database
data/

# Stream log folders (`logs/streams/<stream>/`) must always be committable. A stream named `build` or
# `data` would otherwise be swallowed by the `build/` and `data/` rules above, and its log fragments
# would silently never reach git (Stream D's logs were invisible to git for exactly this reason).
# Gitignore is last-match-wins, so this negation has to stay after those rules.
!logs/streams/*/

# Python bytecode left behind by the benchmark helper scripts
__pycache__/
*.pyc
