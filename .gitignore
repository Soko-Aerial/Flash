build/
# `logs/streams/build/` is Stream A's *log* directory, not a Gradle output directory; without this
# the whole folder is ignored and an integrator's new file there silently never reaches git.
!logs/streams/build/
*.hprof
*.hprof.p*
.gradle/
.idea/
local.properties
.DS_Store
captures/
.externalNativeBuild/
.cxx/
*.log
session-export*/
session-export-*/
logs/cli-diagnostics*.jsonl
testfile.bin
logo-claude/
.kotlin/
.codegraph/
.omo/
.gradle-user-home/
.gradle-user-home-verify/
.kilo/

# Release builds (tools/build-release.ps1): outputs and the signing key config never go in git.
dist/
keystore.properties
*.jks
*.keystore
# SEC-D22-02: private keys and certificates with keys, wherever they land.
*.pem
*.key
*.p12
*.pfx
*.pk8
# PC0 and later device measurement dumps (tools/pc0); summaries go to logs/experiments.md
measurements/

# Server runtime state and local database
data/
