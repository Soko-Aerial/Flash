<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hub logging defaults (REV-13). Without this file logback logs EVERYTHING at DEBUG, including the wire-level chatter of Netty and the
  HTTP client, which is both noisy and the place secrets leak from. The application logs at INFO; libraries at WARN. Override at run
  time with -Dlogback.configurationFile=/path/to/logback.xml (mount your own file in the container).
  Nothing in this application logs a setup token, a password, an authenticator seed, a session cookie, a bearer token or a recovery
  code; server/src/test/.../LogHygieneTest fails the build when one appears.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.transfer.flash" level="INFO"/>
  <logger name="io.netty" level="WARN"/>
  <logger name="io.ktor" level="WARN"/>
  <logger name="org.eclipse.jetty" level="WARN"/>
  <logger name="org.sqlite" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
